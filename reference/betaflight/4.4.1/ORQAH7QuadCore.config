# Betaflight / STM32H743 4.4.0 Apr 27 2021 / 18:42:02 (3ae7e91) MSP API: 1.440000  

#define USE_ACC_SPI_ICM42688P
#define USE_GYRO_SPI_ICM42688P
#define USE_FLASH_W25Q128FV
#define USE_MAX7456
#define USE_MAG
#define USE_MAG_QMC5883
#define USE_BARO
#define USE_BARO_DPS310
#define USE_VBAT_ADC
#define USE_CURRETN_SENSOR_ADC


board_name H7QuadCore
manufacturer_id ORQA

# resources
resource BEEPER 1 E09
resource MOTOR 1 D12
resource MOTOR 2 D13
resource MOTOR 3 A01
resource MOTOR 4 A00
resource MOTOR 5 A02
resource MOTOR 6 A03
resource MOTOR 7 B01
resource MOTOR 8 B00
resource SERVO 1 E06
resource SERVO 2 E05
resource SERIAL_TX 3 D08
resource SERIAL_TX 6 C06
resource SERIAL_TX 7 E08
resource SERIAL_TX 8 E01
resource SERIAL_RX 3 D09
resource SERIAL_RX 6 C07
resource SERIAL_RX 7 E07 
resource SERIAL_RX 8 E00
resource I2C_SCL 1 B06
resource I2C_SDA 1 B07
resource I2C_SCL 2 B10
resource I2C_SDA 2 B11
resource LED 1 A08
resource LED 2 A11
resource LED 3 D11
resource SPI_SCK 1 A05
resource SPI_SCK 2 B13
resource SPI_SCK 3 B03
resource SPI_SCK 4 E12
resource SPI_MISO 1 A06
resource SPI_MISO 2 B14
resource SPI_MISO 3 B04
resource SPI_MISO 4 E13
resource SPI_MOSI 1 A07
resource SPI_MOSI 2 B15
resource SPI_MOSI 3 D06   
resource SPI_MOSI 4 E14   
resource ADC_BATT 1 C00
resource ADC_CURR 1 C01
resource FLASH_CS 1 B12
resource OSD_CS 1 A15
resource GYRO_EXTI 1 C03
resource GYRO_CS 1 A04
resource GYRO_EXTI 2 E10
resource GYRO_CS 2 E11
resource USB_DETECT 1 A09

# timer
timer D12 AF2
# pin D12: TIM4 CH1 (AF2)
timer D13 AF2
# pin D13: TIM4 CH2 (AF2)
timer A01 AF1
# pin A01: TIM2 CH2 (AF1)
timer A00 AF1
# pin A00: TIM2 CH1 (AF1)
timer A02 AF2
# pin A02: TIM5 CH3 (AF2)
timer A03 AF2
# pin A03: TIM5 CH4 (AF2)
timer B01 AF2
# pin B01: TIM3 CH4 (AF2)
timer B00 AF2
# pin B00: TIM3 CH3 (AF2)

timer E06 AF4
# pin E06: TIM15 CH2 (AF4)
timer E05 AF4
# pin E05: TIM15 CH1 (AF4)

timer E09 AF1
# pin E09: TIM1 CH1 (AF1)

dma ADC 1 8
# ADC 1: DMA2 Stream 0 Request 9
dma ADC 3 9
# ADC 3: DMA2 Stream 1 Request 115

dma pin B00 0
# pin B00: DMA1 Stream 0 Request 25
dma pin B01 1
# pin B01: DMA1 Stream 1 Request 26
dma pin A00 2
# pin A00: DMA1 Stream 2 Request 18
dma pin A01 3
# pin A01: DMA1 Stream 3 Request 19
dma pin A02 4
# pin A02: DMA1 Stream 4 Request 57
dma pin A03 5
# pin A03: DMA1 Stream 5 Request 58
dma pin D12 6
# pin D12: DMA1 Stream 6 Request 29
dma pin D13 7
# pin D13: DMA1 Stream 7 Request 30


# feature
feature RX_SERIAL
feature TELEMETRY
feature OSD 
feature GPS

# serial
serial 20 1 115200 57600 0 115200
serial 2 64 115200 57600 0 115200
serial 5 0 115200 57600 0 115200
serial 6 2 115200 57600 0 115200
serial 7 1024 115200 57600 0 115200

# pinio for camera switching
resource PINIO 1 D00
set pinio_box = 43,255,255,255			
set pinio_config = 1,1,1,1

# master
set beeper_inversion = ON
set beeper_od = OFF
set beeper_frequency = 4000
set serialrx_provider = GHST
set blackbox_device = SPIFLASH
set motor_pwm_protocol = DSHOT300
set dshot_bidir = ON
set current_meter = ADC
set battery_meter = ADC
set vbat_scale = 112
set vbat_divider = 1
set vbat_multiplier = 12
set ibata_scale = 108
set baro_bustype = I2C
set baro_i2c_device = 2
set baro_i2c_address = 119
set baro_hardware = DSP310
set mag_bustype = I2C
set mag_i2c_device = 1
set mag_i2c_address = 0
set mag_hardware = AUTO
set system_hse_mhz = 8
set max7456_spi_bus = 3
set dashboard_i2c_bus = 1
set flash_spi_bus = 2
set gyro_1_bustype = SPI
set gyro_1_spibus = 1
set gyro_1_sensor_align = CW270
set gyro_2_bustype = SPI
set gyro_2_spibus = 4
set gyro_2_sensor_align = CW180
set servo_center_pulse = 1500
set servo_pwm_rate = 50
set servo_lowpass_hz = 0

