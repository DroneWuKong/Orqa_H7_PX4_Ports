+static int spi_nor_attach(mtd_instance_s &instance)
+{
+#if defined(CONFIG_MTD_W25)
+	struct spi_dev_s *spi = px4_spibus_initialize(px4_find_spi_bus(instance.devid));
+
+	if (spi == nullptr) {
+		PX4_ERR("failed to locate SPI NOR bus");
+		return -ENXIO;
+	}
+
+	// The W25 driver owns SPI mode, clock and JEDEC identification.
+	instance.mtd_dev = w25_initialize(spi);
+
+	if (instance.mtd_dev == nullptr) {
+		PX4_ERR("failed to initialize W25 flash");
+		return -ENODEV;
+	}
+
+	return 0;
+#else
+	PX4_ERR("Misconfiguration CONFIG_MTD_W25 not set");
+	return -ENXIO;
+#endif
+}
