#!/bin/sh
#
# ORQA H7 Wingcore board specific defaults
#------------------------------------------------------------------------------

# Parameters remain in internal flash across upgrades. Import an old SD
# parameter file explicitly; never overwrite calibration or reboot on insert.

# Battery voltage divider: 10K + 1.2K network
param set-default BAT1_V_DIV 9.2931
param set-default BAT1_A_PER_V 92.6

# system_power unavailable
param set-default CBRK_SUPPLY_CHK 894281

# Select Generic Fixed Wing by default
param set-default SYS_AUTOSTART 2100

# Magnetometer on I2C1
param set-default SYS_HAS_MAG 1

# Enable gravity fusion for EKF2
param set-default EKF2_IMU_CTRL 7

# Buzzer
param set-default CBRK_BUZZER 0

param set-default IMU_GYRO_RATEMAX 2000

# All groups start at servo-compatible 50 Hz. PWM9 (PD14) shares TIM4 with
# PWM7/8, so that group cannot mix DShot motors and a conventional servo.
# Assign motor/control-surface functions in QGC for the actual aircraft;
# function 201 means Servo 1, not a universal aileron assignment.
param set-default PWM_MAIN_TIM0 50
param set-default PWM_MAIN_TIM1 50
param set-default PWM_MAIN_TIM2 50
param set-default PWM_MAIN_TIM3 50
