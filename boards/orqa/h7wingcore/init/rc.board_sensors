#!/bin/sh
#
# ORQA H7 Wingcore specific board sensors init
#------------------------------------------------------------------------------
board_adc start

# IMU 1 on SPI1 - ICM42688P
# BF rotation CW270 = ArduPilot ROLL_180_YAW_270 = PX4 ROTATION_ROLL_180_YAW_270 (R6)
icm42688p -R 6 -s start

# IMU 2 on SPI4 - ICM42688P
# BF rotation CW180 = ArduPilot PITCH_180 = PX4 ROTATION_PITCH_180 (R12)
icm42688p -R 12 -S start

# Barometer - DPS310 on I2C2 @ 0x77
dps310 -I -a 0x77 start
