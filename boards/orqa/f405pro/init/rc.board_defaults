#!/bin/sh
#
# Orqa F405 Pro board specific defaults
#------------------------------------------------------------------------------

# system_power unavailable
param set-default CBRK_SUPPLY_CHK 894281
param set-default CBRK_IO_SAFETY 22027

# Battery: ArduPilot hwdef VOLT_SCALE 8.3, CURR_SCALE 92.6
param set-default BAT1_V_DIV 8.3
param set-default BAT1_A_PER_V 92.6
param set-default BAT1_N_CELLS 4

# Generic Quadrotor X
param set-default SYS_AUTOSTART 4001

# External mag probing
param set-default SYS_HAS_MAG 1

# RCInput auto-detects supported protocols (including Ghost) on USART1.
param set-default RC_INPUT_PROTO -1

# PX4 v1.15 selects the output protocol per timer group (-4 = DShot300).
param set-default PWM_MAIN_TIM0 -4
param set-default PWM_MAIN_TIM1 -4
param set-default PWM_MAIN_TIM2 -4

# The hardware's motor numbering crosses timer groups. PX4 requires channels
# from one timer to be contiguous, so explicitly bind functions to the grouped
# channel order used by timer_config.cpp.
param set-default PWM_MAIN_FUNC1 101  # Motor 1 (PA3)
param set-default PWM_MAIN_FUNC2 104  # Motor 4 (PA2)
param set-default PWM_MAIN_FUNC3 105  # Motor 5 (PA0)
param set-default PWM_MAIN_FUNC4 106  # Motor 6 (PA1)
param set-default PWM_MAIN_FUNC5 102  # Motor 2 (PB0)
param set-default PWM_MAIN_FUNC6 103  # Motor 3 (PB1)
param set-default PWM_MAIN_FUNC7 107  # Motor 7 (PC8)
param set-default PWM_MAIN_FUNC8 108  # Motor 8 (PC9)
