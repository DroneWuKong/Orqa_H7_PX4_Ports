#!/bin/sh
#
# ORQA DTK APB (STM32H743 FC) board specific sensors init
#
# Probe matrix mirrors ORQA's official PX4 APB target
# (orqafpv/PX4-Autopilot develop_APB-initial): MPU6000-class on SPI1,
# ICM42605 (R12) or ICM42688P (R14) on SPI4. Rotations differ per chip on
# SPI4 because the two footprint options are mounted differently.
#------------------------------------------------------------------------------
board_adc start

# IMU 1 on SPI1 (CS=PA4) — MPU6000, ICM42688P fallback (later revs)
# PX4: ROTATION_PITCH_180 (R12)
mpu6000 -R 12 -b 1 -s start
if [ $? -ne 0 ]; then
	icm42688p -R 12 -b 1 -s start
fi

# IMU 2 on SPI4 (CS=PE11, DRDY=PE10) — ICM42605 (R12), ICM42688P (R14)
icm42605 -R 12 -b 4 -s start
if [ $? -ne 0 ]; then
	icm42688p -R 14 -b 4 -s start
fi

# Barometer — DPS310 on I2C2 @ 0x77 (119 decimal)
dps310 -I start -a 119

# Magnetometer — QMC5883 on I2C1 @ 0x0D (13 decimal), external
qmc5883l -X start -a 13

# GPS on UART7 (ttyS3 — UART4/IMX bridge shifts the ordering vs QuadCore)
gps start -d /dev/ttyS3 -p ubx
